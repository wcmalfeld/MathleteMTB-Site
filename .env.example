# Copy to .env (never committed) to use scripts/admin.mjs and
# scripts/test-access.mjs from your computer.

# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Full admin access to your project. Keep it in .env only:
# never in the website, the repository, or GitHub variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite and password-reset links send people.
SITE_URL=https://www.mathletemtb.com

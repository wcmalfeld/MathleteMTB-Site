# Secrets: the service_role key and other admin settings live here only.
.env
.env.*
!.env.example

# Generated on deploy from repository variables (see .github/workflows/static.yml).
js/supabase-config.js

# Source files for members-only tools. These are uploaded to the private
# Supabase Storage bucket and must never be published with the site.
private-tools/

.DS_Store

# Teacher lesson plans (answer keys). The sources stay off the public repo;
# scripts/build-teacher-curriculum.mjs builds them and
# `node scripts/admin.mjs lessons-upload` puts them in Supabase, where only
# teachers can read them. Back this folder up somewhere private.
private-content/
